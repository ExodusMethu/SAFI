# Next.js / Vercel environment variables. Values come from your existing projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=safi-audio
NEXT_PUBLIC_R2_PUBLIC_URL=
# Assign the actual HTTPS URL after the free Render worker is deployed.
MUSIC_IMPORT_WORKER_URL=
# Must match the secret on Render. Never prefix this with NEXT_PUBLIC_.
MUSIC_IMPORT_WORKER_SECRET=
