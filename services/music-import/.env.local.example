# New PC: copy to .env.local in this folder and fill in every setting below.
# If the repository root .env.local already has these values, no copy is needed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=safi-audio
IMPORT_MAX_TRACKS=200
# Alternatively use SAFI's upload gateway instead of storing R2 keys here:
# IMPORT_UPLOAD_API_URL=https://your-safi-app/api/music-import-upload
# MUSIC_IMPORT_WORKER_SECRET=the-same-secret-as-your-deployed-app
